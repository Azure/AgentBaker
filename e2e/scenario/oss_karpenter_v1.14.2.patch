 func getCredential(env *auth.Environment) (azcore.TokenCredential, error) {
+	// AgentBaker's E2E controller runs out of cluster under an authenticated Azure
+	// CLI session. Prefer that explicit identity instead of allowing
+	// DefaultAzureCredential to select an unrelated managed identity from the test
+	// runner host.
+	if os.Getenv("AGENTBAKER_E2E_USE_AZURE_CLI") == "true" {
