[Unit]
Description=Emit system cgroup pressure telemetry
After=kubelet.service containerd.service
ConditionPathExists=/sys/fs/cgroup/cgroup.controllers
OnSuccess=service-execution-telemetry@cgroup\x2dpressure\x2dtelemetry.service.service
OnFailure=service-execution-telemetry@cgroup\x2dpressure\x2dtelemetry.service.service

[Service]
Type=oneshot
CPUAccounting=true
MemoryAccounting=true
ExecStart=/bin/bash /opt/scripts/cgroup-pressure-telemetry.sh
ExecStopPost=-/opt/scripts/service-execution-telemetry.sh --snapshot-memory-peak %n
