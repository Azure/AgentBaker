[Unit]
Description=Localdns DNS fallback (NAT redirects for 169.254.10.10 and 169.254.10.11)
# Only meaningful on images that run localdns.
ConditionKernelVersion=>=5.15
# Started by localdns.service's OnFailure=. It must never win a race against a
# recovering localdns for the redirects: localdns.service has an ExecStartPre
# that stops this unit, which runs 'clear'. That stop is the only handoff.
#
# Deliberately NO 'Conflicts=localdns.service'. Measured on a live node (systemd
# 255): starting this unit resolved that Conflicts by stopping localdns.service,
# and a stop RESETS localdns's restart counter ('Scheduled restart job, restart
# counter is at 1' on every cycle). localdns therefore never spent its 720/5
# budget and never reached terminal 'failed' -- defeating both the OnFailure=
# handoff this unit is gated on and the stable state NPD is meant to observe.
Before=localdns.service
# Unbounded start budget. localdns.service's OnFailure= can fire more than once
# while localdns works through its restart budget, and apply_rules no-ops on
# anything other than terminal 'failed'. Without this, that burst of gated
# no-ops would spend the default 5-start allowance and systemd would refuse the
# one start that matters.
StartLimitIntervalSec=0

[Service]
# No daemon: ExecStart installs nat rules and exits. RemainAfterExit keeps the
# unit 'active' so that 'systemctl stop' is a meaningful operation and runs
# ExecStop to tear the rules down.
Type=oneshot
RemainAfterExit=yes
# Skips rather than fails the unit on the starts where localdns is still working
# through its restart budget: 'systemctl is-failed' is 0 only for terminal
# 'failed'. apply re-checks the same state, so manual runs stay guarded.
ExecCondition=/usr/bin/systemctl is-failed localdns.service
ExecStart=/opt/azure/containers/localdns/localdns-fallback.sh apply
ExecStop=/opt/azure/containers/localdns/localdns-fallback.sh clear
Slice=localdns.slice

# Deliberately NOT installed / not WantedBy any target: this unit is only ever
# activated on demand via localdns.service OnFailure=, never enabled at boot.
# The rules live only in the kernel's runtime tables, so a reboot leaves nothing
# behind and there is nothing to restore.
