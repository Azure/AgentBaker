[Unit]
Description=Localdns service
Wants=network.target
After=network.target
After=cloud-config.service
Before=kubelet.service
Before=containerd.service
# don't run on old images; we're not compatible
ConditionKernelVersion=>=5.15
# Bound the restart budget so unrecoverable failures terminate in 'failed' rather than
# restarting forever. Threshold = StartLimitIntervalSec/StartLimitBurst = 144s, above the
# slowest restart cycle (TimeoutStartSec + TimeoutStopSec + RestartSec: 122s on Ubuntu,
# 107s on Azure Linux). A failure repeating more slowly than the threshold never
# accumulates StartLimitBurst starts inside the window, so it never reaches 'failed' --
# which is the state NPD observes and the OnFailure= handoff below fires on.
StartLimitIntervalSec=720
StartLimitBurst=5
# OnFailure= starts the pod-DNS fallback so 169.254.10.11 keeps answering for
# already-running pods while localdns is down. Note that systemd fires this on
# EVERY failed start attempt, not only on entry to the terminal 'failed' state:
# measured on a live node (systemd 255), 'Triggering OnFailure= dependencies'
# appears once per restart cycle while 'systemctl is-failed' still reports
# 'activating'. localdns-fallback.sh therefore re-checks localdns's SubState and
# no-ops while it is in auto-restart, so only a settled localdns hands over .11.
OnFailure=localdns-fallback.service

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=60
Restart=on-failure
# Stop the pod-DNS fallback before we touch the shared dummy interface. localdns
# start (add_iptable_rules_to_skip_conntrack_from_pods) deletes and recreates the
# interface carrying .11; if the fallback were still bound, recovery would yank
# its socket mid-flight. This synchronous stop is the ONLY handoff — the fallback
# deliberately carries no Conflicts=localdns.service, because resolving that
# conflict stopped this unit and reset its restart counter, so the 720/5 budget
# above was never spent and 'failed' was never reached. '-' so a not-running
# fallback is not an error.
ExecStartPre=-/usr/bin/systemctl stop localdns-fallback.service
# Load-bearing: give each restart time to sample real system state instead of
# re-entering the transient it is retrying against. cleanup_iptables_and_dns
# runs 'networkctl reload' on every start, and the dummy interface carrying the
# node (169.254.10.10) and cluster (169.254.10.11) listeners is deleted and
# recreated on every start. At sub-second retries these overlap; 2s lets
# networkd settle and an orphaned coredns release its sockets before ExecStart.
RestartSec=2
KillMode=mixed
# Revert node DNS configuration even when the supervisor exits unexpectedly.
ExecStopPost=/opt/azure/containers/localdns/localdns.sh cleanup
TimeoutStopSec=30
Slice=localdns.slice
EnvironmentFile=-/etc/localdns/environment
ExecStart=/opt/azure/containers/localdns/localdns.sh

[Install]
WantedBy=multi-user.target
