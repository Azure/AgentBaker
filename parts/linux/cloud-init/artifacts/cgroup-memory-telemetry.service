[Unit]
Description=Emit system cgroup memory telemetry
OnSuccess=service-execution-telemetry@cgroup\x2dmemory\x2dtelemetry.service.service
OnFailure=service-execution-telemetry@cgroup\x2dmemory\x2dtelemetry.service.service

[Service]
Type=oneshot
CPUAccounting=true
MemoryAccounting=true
ExecStart=/bin/bash /opt/scripts/cgroup-memory-telemetry.sh