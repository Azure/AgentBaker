[Unit]
Description=Apply MIG configuration on Nvidia A100 GPU
Before=nvidia-device-plugin.service

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
ExecStartPre=/usr/bin/nvidia-smi -mig 1
ExecStart=/bin/bash /opt/azure/containers/mig-partition.sh "${GPU_INSTANCE_PROFILE}" "${TOTAL_GPU_INSTANCE_SLICES}"
TimeoutSec=300

[Install]
WantedBy=multi-user.target
