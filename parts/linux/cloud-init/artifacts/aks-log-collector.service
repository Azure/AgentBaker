[Unit]
Description=AKS Log Collector
OnSuccess=service-execution-telemetry@aks\x2dlog\x2dcollector.service.service
OnFailure=service-execution-telemetry@aks\x2dlog\x2dcollector.service.service

[Service]
Type=oneshot
Slice=aks-log-collector.slice
CPUAccounting=true
MemoryAccounting=true
ExecStart=/opt/azure/containers/aks-log-collector.sh
ExecStopPost=-/opt/scripts/service-execution-telemetry.sh --snapshot-memory-peak %n
RemainAfterExit=no
