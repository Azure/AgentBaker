[Unit]
Description=AKS continuous Inspektor Gadget diagnostics
After=containerd.service
ConditionPathExists=/etc/ig.d/skip_vhd_ig
ConditionPathExists=/sys/fs/cgroup/cgroup.controllers
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
UMask=0077
RuntimeDirectory=ig-diagnostics
RuntimeDirectoryMode=0700
StateDirectory=ig-diagnostics/gadgets
StateDirectoryMode=0700
LogsDirectory=ig-diagnostics
LogsDirectoryMode=0700
# IG's persistent-instance path is fixed; isolate it from other IG users.
BindPaths=/var/lib/ig-diagnostics/gadgets:/var/lib/ig/gadgets
ExecStart=/usr/bin/ig --config /etc/ig.d/diagnostics.yaml daemon --host unix:///run/ig-diagnostics/ig.socket --group 0 --tls-insecure
ExecStartPost=/usr/share/inspektor-gadget/diagnostics.sh
ExecStopPost=/usr/bin/rm -f /run/ig-diagnostics/collectors.json
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=15
CPUAccounting=true
MemoryAccounting=true
TasksAccounting=true

[Install]
WantedBy=multi-user.target
