{
    "type": "Microsoft.VirtualMachineImages",
    "apiVersion": "2025-10-01",
    "location": "<LOCATION>",
    "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
            "<IMAGE_BUILDER_IDENTITY_ID>": {}
        }
    },
    "properties": {
        "buildTimeoutInMinutes": 60,
        "source": {
            "type": "<SOURCE_TYPE>",
            "<SOURCE_ID_KEY>": "<SOURCE_ID>"
        },
        "customize": [
            {
                "type": "File",
                "name": "StageACLDeprovisionHelper",
                "sourceUri": "<WORKLOAD_OPTIMIZATION_SCRIPT_URL>",
                "destination": "/tmp/acl-prefetch-driver.sh"
            },
            {
                "type": "Shell",
                "name": "ConfigureACLDeprovisioning",
                "inline": [
                    "command -v acl-image-prepare >/dev/null || { echo 'ACL base image must include acl-image-prepare' >&2; exit 1; }",
                    "printf '%s\\n' '#!/bin/bash' 'set -euo pipefail' 'sudo /bin/bash /tmp/acl-prefetch-driver.sh --deprovision' | sudo tee /tmp/DeprovisioningScript.sh >/dev/null"
                ]
            }
        ],
        "optimize": {
            "vmBoot": {
                "state": "Enabled"
            },
            "workload": {
                "state": "Enabled",
                "scriptUri": "<WORKLOAD_OPTIMIZATION_SCRIPT_URL>"
            }
        },
        "distribute": [
            {
                "type": "VHD",
                "runOutputName": "VHD"
            }
        ]
    }
}
