{
    "type": "Microsoft.VirtualMachineImages",
    "apiVersion": "2025-10-01",
    "location": "<LOCATION>",
    "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
            "<IMAGE_BUILDER_IDENTITY_ID>": {}
        }
    },
    "properties": {
        "source": {
            "type": "<SOURCE_TYPE>",
            "<SOURCE_ID_KEY>": "<SOURCE_ID>"
        },
        "customize": [
            {
                "type": "Shell",
                "name": "InstallDeprovisionHook",
                "inline": [
                    "printf '%s\\n' '#!/bin/bash -eu' 'rm -f \"$0\"' 'exec sudo /opt/azure/containers/aks-node-controller generalize' | sudo tee /tmp/DeprovisioningScript.sh >/dev/null && sudo chmod 0755 /tmp/DeprovisioningScript.sh"
                ]
            }
        ],
        "optimize": {
            "vmBoot": {
                "state": "Enabled"
            },
            "workload": {
                "state": "Enabled",
                "scriptUri": "<WORKLOAD_OPTIMIZATION_SCRIPT_URL>"
            }
        },
        "distribute": [
            {
                "type": "VHD",
                "runOutputName": "VHD"
            }
        ]
    }
}
