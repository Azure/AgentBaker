# PMC repos for the Azure Local edge node image, matching the channels the
# production aksarc-vhd/AzureLocal build uses.
#
# Verified against live PMC repodata (packages.microsoft.com/azurelinux/3.0):
#   - k8s binaries (bare names kubeadm/kubelet/kubectl, many minors incl.
#     1.33/1.34/1.35) live in prod/cloud-native.
#   - cni-plugins (1.4.0) and containerd (1.7.13) live in prod/base.
# These are enabled so download-k8s-bin-style staging can resolve per-version
# k8s RPMs. $basearch resolves against the Azure Linux 3.0 base (x86_64).
[azurelinux3.0prodcloud-nativex86_64]
name=azurelinux/3.0/prod/cloud-native/$basearch
baseurl=https://packages.microsoft.com/azurelinux/3.0/prod/cloud-native/$basearch/
gpgcheck=1
repo_gpgcheck=1
enabled=1
gpgkey=https://packages.microsoft.com/azurelinux/3.0/prod/cloud-native/$basearch/repodata/repomd.xml.key

[azurelinux3.0prodbasex86_64]
name=azurelinux/3.0/prod/base/$basearch
baseurl=https://packages.microsoft.com/azurelinux/3.0/prod/base/$basearch/
gpgcheck=1
repo_gpgcheck=1
enabled=1
gpgkey=https://packages.microsoft.com/azurelinux/3.0/prod/base/$basearch/repodata/repomd.xml.key
