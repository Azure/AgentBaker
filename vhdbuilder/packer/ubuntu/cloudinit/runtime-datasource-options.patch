+def _ds_cfg_overrides_from_customdata(userdata_raw) -> dict:
+    """Read only explicitly allowed datasource options before reporting Ready."""
+    if isinstance(userdata_raw, bytes):
+        try:
+            userdata_raw = userdata_raw.decode("utf-8")
+        except UnicodeDecodeError:
+            report_diagnostic_event(
+                "Ignoring non-UTF-8 datasource custom data",
+                logger_func=LOG.warning,
+            )
+            return {}
+    if not isinstance(userdata_raw, str):
+        return {}
+    lines = userdata_raw.lstrip().splitlines()
+    if not lines:
+        return {}
+    if lines[0].strip() == "#cloud-config":
+        return _ds_cfg_from_cloud_config(userdata_raw)
+    if lines[0].strip() != "#cloud-config-archive":
+        return {}
+
+    overrides = {}
+    entries = util.load_yaml(userdata_raw, default=[], allowed=(list,))
+    for entry in entries:
+        if isinstance(entry, str):
+            entry = {"content": entry}
+        if not isinstance(entry, dict) or not isinstance(
+            entry.get("content"), str
+        ):
+            report_diagnostic_event(
+                "Ignoring invalid cloud-config-archive entry",
+                logger_func=LOG.warning,
+            )
+            continue
+        content = entry["content"]
+        content_type = entry.get("type") or handlers.type_from_starts_with(
+            content, "text/cloud-config"
+        )
+        if content_type == "text/cloud-config":
+            overrides.update(_ds_cfg_from_cloud_config(content))
+    return overrides
+
+
+def _ds_cfg_from_cloud_config(content) -> dict:
+    config = util.load_yaml(content, default={})
+    for key in ("datasource", "Azure"):
+        config = config.get(key, {})
+        if not isinstance(config, dict):
+            report_diagnostic_event(
+                "Ignoring invalid datasource mapping in custom data",
+                logger_func=LOG.warning,
+            )
+            return {}
+
+    option = "experimental_skip_ready_report"
+    if option not in config:
+        return {}
+    if not isinstance(config[option], bool):
+        report_diagnostic_event(
+            "Ignoring non-boolean experimental_skip_ready_report",
+            logger_func=LOG.warning,
+        )
+        return {}
+    return {option: config[option]}
+
+
