--- /dev/null
+++ b/tests/unittests/sources/test_azure_runtime_options.py
@@ -0,0 +1,127 @@
+import pytest
+import yaml
+
+from cloudinit.sources.DataSourceAzure import _ds_cfg_overrides_from_customdata
+from cloudinit.user_data import UserDataProcessor
+
+
+@pytest.mark.parametrize("enabled", [True, False])
+@pytest.mark.parametrize("as_bytes", [True, False])
+def test_boolean_override(enabled, as_bytes):
+    config = (
+        "#cloud-config\ndatasource:\n  Azure:\n"
+        f"    experimental_skip_ready_report: {str(enabled).lower()}\n"
+        "    apply_network_config: false\n"
+        "    data_dir: /untrusted\n"
+    )
+    if as_bytes:
+        config = config.encode()
+    assert _ds_cfg_overrides_from_customdata(config) == {
+        "experimental_skip_ready_report": enabled
+    }
+
+
+@pytest.mark.parametrize(
+    "config",
+    [
+        None,
+        "",
+        b"\xff",
+        "#cloud-config\n",
+        "#cloud-config\n[not, a, mapping]",
+        "#cloud-config\ndatasource: null",
+        "#cloud-config\ndatasource:\n  Azure: []",
+        "#cloud-config\ndatasource:\n  Azure:\n    data_dir: /untrusted",
+        "#cloud-config\ndatasource: [",
+        "#cloud-config\ndatasource:\n  Azure:\n"
+        '    experimental_skip_ready_report: "false"',
+        "#cloud-config\ndatasource:\n  Azure:\n"
+        "    experimental_skip_ready_report: 1",
+        "#cloud-config\ndatasource:\n  Azure:\n"
+        "    experimental_skip_ready_report: null",
+        "#cloud-boothook\n# azure-experimental-node-ready\n",
+        "Content-Type: multipart/mixed\n\n#cloud-config\n",
+    ],
+)
+def test_no_override(config):
+    assert _ds_cfg_overrides_from_customdata(config) == {}
+
+
+def archive(entries):
+    return "#cloud-config-archive\n" + yaml.safe_dump(entries)
+
+
+def cloud_config(enabled):
+    return (
+        "datasource:\n  Azure:\n"
+        f"    experimental_skip_ready_report: {str(enabled).lower()}\n"
+        "    apply_network_config: false\n"
+        "bootcmd:\n- echo bootcmd\n"
+    )
+
+
+@pytest.mark.parametrize("enabled", [True, False])
+@pytest.mark.parametrize("as_bytes", [True, False])
+@pytest.mark.parametrize("explicit_type", [True, False])
+def test_archive_override(enabled, as_bytes, explicit_type):
+    entry = {"content": cloud_config(enabled)}
+    if explicit_type:
+        entry["type"] = "text/cloud-config"
+    payload = archive(
+        [
+            {"type": "text/cloud-boothook", "content": "#!/bin/sh\necho hook\n"},
+            entry,
+        ]
+    )
+    if as_bytes:
+        payload = payload.encode()
+    assert _ds_cfg_overrides_from_customdata(payload) == {
+        "experimental_skip_ready_report": enabled
+    }
+
+
+def test_archive_part_order_and_scalar_content():
+    assert _ds_cfg_overrides_from_customdata(
+        archive([cloud_config(True), cloud_config(False)])
+    ) == {"experimental_skip_ready_report": False}
+    assert _ds_cfg_overrides_from_customdata(
+        archive([cloud_config(False), cloud_config(True)])
+    ) == {"experimental_skip_ready_report": True}
+
+
+@pytest.mark.parametrize(
+    "entries",
+    [
+        [],
+        {},
+        [None, 42, {"content": []}, {"type": "text/cloud-config"}],
+        [{"type": "text/cloud-boothook", "content": cloud_config(True)}],
+        [{"content": "#!/bin/sh\n" + cloud_config(True)}],
+        [{"type": "text/cloud-config", "content": "datasource: null"}],
+        [{"type": "text/cloud-config", "content": "datasource: ["}],
+        [{"type": "text/cloud-config", "content": "datasource:\n  Azure: []"}],
+        [{"type": "text/cloud-config", "content": cloud_config("invalid")}],
+    ],
+)
+def test_archive_ignores_invalid_or_unrelated_parts(entries):
+    assert _ds_cfg_overrides_from_customdata(archive(entries)) == {}
+
+
+def test_cloud_init_expands_archive_without_running_commands():
+    payload = archive(
+        [
+            {"type": "text/cloud-boothook", "content": "#!/bin/sh\necho hook\n"},
+            {"type": "text/cloud-config", "content": cloud_config(True)},
+        ]
+    )
+    message = UserDataProcessor(None).process(payload)
+    parts = message.get_payload()
+    assert [part.get_content_type() for part in parts] == [
+        "text/cloud-boothook",
+        "text/cloud-config",
+    ]
+    config = yaml.safe_load(parts[1].get_payload())
+    assert config["bootcmd"] == ["echo bootcmd"]
+    assert _ds_cfg_overrides_from_customdata(payload) == {
+        "experimental_skip_ready_report": True
+    }
