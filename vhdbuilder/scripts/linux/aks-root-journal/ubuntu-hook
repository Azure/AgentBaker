#!/bin/sh

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions
[ ! -r /conf/param.conf ] || . /conf/param.conf

ROOT_ARGUMENT=${ROOT:-}
if [ -z "$ROOT_ARGUMENT" ]; then
    for argument in $(cat /proc/cmdline); do
        case "$argument" in
            root=*)
                ROOT_ARGUMENT=${argument#root=}
                break
                ;;
        esac
    done
fi

if ! /sbin/aks-root-journal-resize "$ROOT_ARGUMENT"; then
    panic "AKS root journal sizing failed; refusing to mount the root filesystem"
fi
