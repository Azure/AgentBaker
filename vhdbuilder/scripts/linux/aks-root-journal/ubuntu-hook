#!/bin/sh

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions
[ ! -r /conf/param.conf ] || . /conf/param.conf

KMSG_DEVICE=/dev/kmsg

kernel_log() {
    if [ -w "$KMSG_DEVICE" ]; then
        printf '<6>aks-root-journal: Ubuntu initramfs hook %s\n' "$*" > "$KMSG_DEVICE" 2>/dev/null || :
    fi
}

kernel_log started
ROOT_ARGUMENT=${ROOT:-}
if [ -z "$ROOT_ARGUMENT" ]; then
    for argument in $(cat /proc/cmdline); do
        case "$argument" in
            root=*)
                ROOT_ARGUMENT=${argument#root=}
                break
                ;;
        esac
    done
fi

if /sbin/aks-root-journal-resize "$ROOT_ARGUMENT"; then
    kernel_log completed
else
    HELPER_STATUS=$?
    kernel_log "failed with exit status $HELPER_STATUS"
    panic "AKS root journal sizing failed; refusing to mount the root filesystem"
fi
